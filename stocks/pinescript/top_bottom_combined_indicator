indicator("Pivot Hub V23 + MTF Expert Trade Engine", shorttitle="Master Wizard", overlay=false)

// --- User Inputs ---
CCVResolution = input.float(1.0, title="Volume Profile Resolution (Tick Size)")

// =========================================================================
// SECTION 1: CORE FUNCTIONS
// =========================================================================

round_to_nearest(v, x) => math.round(v / x) * x

HMA(_src, _length) => 
    ta.wma(2 * ta.wma(_src, _length / 2) - ta.wma(_src, _length), math.round(math.sqrt(_length)))

f_frama(src, len) =>
    w = math.max(1, math.floor(len / 2))
    h1 = ta.highest(src, w), l1 = ta.lowest(src, w), n1 = (h1 - l1) / w
    h2 = ta.highest(src, w)[w], l2 = ta.lowest(src, w)[w], n2 = (h2 - l2) / w
    h3 = ta.highest(src, w * 2), l3 = ta.lowest(src, w * 2), n3 = (h3 - l3) / (w * 2)
    
    n1_safe = math.max(n1, 0.0001), n2_safe = math.max(n2, 0.0001), n3_safe = math.max(n3, 0.0001)
    D = (math.log(n1_safe + n2_safe) - math.log(n3_safe)) / math.log(2)
    alpha = math.max(0.01, math.min(1.0, math.exp(-4.6 * (D - 1))))
    
    var float filt = na
    filt := na(filt[1]) ? src : alpha * src + (1 - alpha) * filt[1]
    filt

f_poc(tf) =>
    var float[] a = array.new_float(0)
    tick_size = math.max(syminfo.mintick, CCVResolution)
    var float a_min = round_to_nearest(low, tick_size)
    a_min := nz(a_min[1], round_to_nearest(low, tick_size))
    
    d_switch = ta.change(time(tf)) != 0
    if d_switch
        a_min := low
        array.clear(a)

    v_min = int(round_to_nearest(low - a_min, tick_size) / tick_size)
    v_max = int(round_to_nearest(high - a_min, tick_size) / tick_size)
    ticks = v_max - v_min
    vol = volume / (ticks == 0 ? 1 : ticks)
    
    for i = v_min to math.max(v_max - 1, v_min)
        if i >= 0
            index = int(i)
            if index >= array.size(a)
                array.push(a, vol)
            else
                array.set(a, index, array.get(a, index) + vol)

    a_size = array.size(a)
    poc_index = -1, poc_prev = -1.0, sum_vol = 0.0

    for i = 0 to a_size - 1
        poc_current = array.get(a, i)
        sum_vol += poc_current
        if poc_current > poc_prev
            poc_prev := poc_current
            poc_index := i

    va_high_index = poc_index, va_low_index = poc_index
    va_vol_cap = sum_vol * 0.70 
    sum_va_vol = array.size(a) > poc_index ? array.get(a, poc_index) : 0.0

    for _ = 1 to a_size - 1
        above = (va_high_index + 1 < a_size) ? nz(array.get(a, va_high_index + 1), 0) : 0
        below = (va_low_index - 1 >= 0) ? nz(array.get(a, va_low_index - 1), 0) : 0
        if above > below
            va_high_index := math.min(va_high_index + 1, a_size - 1)
            sum_va_vol += above
        else
            va_low_index := math.max(va_low_index - 1, 0)
            sum_va_vol += below
        if sum_va_vol >= va_vol_cap
            break

    float poc = poc_index * tick_size + a_min
    float va_high = va_high_index * tick_size + a_min
    float va_low = va_low_index * tick_size + a_min

    var float pd_poc = na, var float pd_vah = na, var float pd_val = na
    if d_switch
        pd_poc := poc[1], pd_vah := va_high[1], pd_val := va_low[1]
    else
        pd_poc := nz(pd_poc[1]), pd_vah := nz(pd_vah[1]), pd_val := nz(pd_val[1])
    [pd_poc, pd_vah, pd_val]

evaluate_line_trend(val) =>
    sma50 = ta.sma(val, 50)
    (val > sma50 ? 1 : val < sma50 ? -1 : 0) * 4 

f_rti(_src, _trendLen, _sensitivity) =>
    upper_trend = _src + ta.stdev(_src, 2), lower_trend = _src - ta.stdev(_src, 2)
    upper_array = array.new<float>(0), lower_array = array.new<float>(0)
    for i = 0 to _trendLen - 1
        array.push(upper_array, nz(upper_trend[i])), array.push(lower_array, nz(lower_trend[i]))
    array.sort(upper_array), array.sort(lower_array)
    upper_index = math.max(0, math.min(math.round(_sensitivity / 100 * _trendLen) - 1, _trendLen - 1))
    lower_index = math.max(0, math.min(math.round((100 - _sensitivity) / 100 * _trendLen) - 1, _trendLen - 1))
    UpperTrend = array.get(upper_array, upper_index)
    LowerTrend = array.get(lower_array, lower_index)
    rangeRTI = UpperTrend - LowerTrend
    rangeRTI != 0 ? (((_src - LowerTrend) / rangeRTI) * 100) + 300 : 350

// =========================================================================
// SECTION 2: THE FRACTAL MTF ENGINE 
// =========================================================================

calc_tf_score() =>
    s1 = evaluate_line_trend(ta.obv)
    curr_ad = close > nz(close[1]) ? close - math.min(low, nz(close[1])) : close < nz(close[1]) ? close - math.max(high, nz(close[1])) : 0.0
    s3 = evaluate_line_trend(ta.cum(curr_ad))
    s4 = evaluate_line_trend(ta.mfi(close, 14))
    mf_mult = (high != low) ? ((close - low) - (high - close)) / (high - low) : 0.0
    s5 = evaluate_line_trend(math.sum(mf_mult * volume, 20) / math.sum(volume, 20))
    s7 = evaluate_line_trend(close)

    hh = ta.highest(high, 20)[1], ll = ta.lowest(low, 20)[1]
    donch = (close > hh ? 1 : close < ll ? -1 : 0) * 4
    bopen_local = ta.linreg(open, 11, 0), bclose_local = ta.linreg(close, 11, 0)
    lr = (bclose_local > bopen_local ? 1 : bclose_local < bopen_local ? -1 : 0) * 4
    hull_local = HMA(close, 55)
    ht = (hull_local > hull_local[2] ? 1 : hull_local < hull_local[2] ? -1 : 0) * 4

    s1 + s3 + s4 + s5 + s7 + donch + lr + ht 

grand_composite = nz(request.security(syminfo.tickerid, "1", calc_tf_score())) + nz(request.security(syminfo.tickerid, "15", calc_tf_score())) + nz(request.security(syminfo.tickerid, "60", calc_tf_score())) + nz(request.security(syminfo.tickerid, "240", calc_tf_score())) + nz(request.security(syminfo.tickerid, "D", calc_tf_score()))
composite_ma = ta.wma(grand_composite, 11)

// =========================================================================
// SECTION 3: THE OSCILLATOR ENGINE (CONTINUOUS FLOW)
// =========================================================================

kRaw = 100 * (close - ta.lowest(low, 30)) / (ta.highest(high, 30) - ta.lowest(low, 30)) + 100
kWeighted = ta.wma(ta.sma(kRaw, 7), 21)
dLine = ta.sma(ta.sma(kRaw, 7), 6)
stoch_score = ((kWeighted - 150) / 50) * 20 

up_c = ta.highest(composite_ma, 14), dn_c = ta.lowest(composite_ma, 14)
diff_c = up_c > up_c[1] ? (up_c - dn_c) : dn_c < dn_c[1] ? -(up_c - dn_c) : composite_ma - nz(composite_ma[1])
arsi = (ta.rma(diff_c, 14) / ta.rma(math.abs(diff_c), 14)) * 50 + 50 + 200
arsi_score = ((arsi - 250) / 50) * 20

rti_score = ((f_rti(composite_ma + 300, 100, 95) - 350) / 50) * 20
oscillator_score = math.max(-60, math.min(60, stoch_score + arsi_score + rti_score))

// =========================================================================
// SECTION 4: THE VALUE AREA & VOLATILITY ENGINE
// =========================================================================

[ph, pl, pc] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)
range_fixed = ph - pl
H3 = pc + range_fixed * 1.1 / 4
L3 = pc - range_fixed * 1.1 / 4
pivot = (ph + pl + pc) / 3.0

var float cumPV = 0.0, var float cumVol = 0.0
if timeframe.change("D")
    cumPV := 0.0, cumVol := 0.0
cumPV += close * volume, cumVol += volume
daily_vwap = cumVol > 0 ? cumPV / cumVol : close

var float pd_vwap = na
if timeframe.change("D")
    pd_vwap := daily_vwap[1]

[pd_poc, pd_vah, pd_val] = request.security(syminfo.tickerid, "D", f_poc("D"), lookahead=barmerge.lookahead_on)

cpr_score = close > pivot ? 10 : close < pivot ? -10 : 0
vwap_score = close > daily_vwap ? 10 : close < daily_vwap ? -10 : 0
value_area_score = close > pd_vah ? 20 : close < pd_val ? -20 : (close > pd_poc ? 5 : -5)
value_score = cpr_score + vwap_score + value_area_score

vix_close = request.security("NSE:INDIAVIX", "D", close[1], lookahead=barmerge.lookahead_on)
price_offset = pc * ((vix_close / 19.1) / 100)
vix_exhaustion_bull = close > (pc + 1.25 * price_offset)
vix_exhaustion_bear = close < (pc - 1.25 * price_offset)

// =========================================================================
// SECTION 5: SCORING, FRAMA CLOUD & DISPLAY
// =========================================================================

raw_master_score = ta.wma(grand_composite + oscillator_score + value_score, 8)
normalized_score = ((raw_master_score + 260) / 520) * 100
osc_color = normalized_score >= 60 ? color.green : normalized_score <= 40 ? color.red : color.gray

signal_frama = f_frama(normalized_score, 34)

// Mathematical Gap Plug (Hysteresis Buffer Dead Zone)
noise_buffer = 2.5 
frama_upper = signal_frama + noise_buffer
frama_lower = signal_frama - noise_buffer

p_master = plot(normalized_score, "Smoothed Master Line", osc_color, 2)
p_frama = plot(signal_frama, "Vector FRAMA Signal", color.white, 2)
plot(frama_upper, "Gap Upper", color.new(color.white, 90), 1)
plot(frama_lower, "Gap Lower", color.new(color.white, 90), 1)

// Momentum Gap Cloud (Visually highlighting chop vs clean breakouts)
gap_color = normalized_score > frama_upper ? color.new(color.lime, 70) : normalized_score < frama_lower ? color.new(color.red, 70) : color.new(color.gray, 85)
fill(p_master, p_frama, color=gap_color, title="Momentum Gap Cloud")

hline(80, "Strong Bull / Exhaustion", color.new(color.green, 50), hline.style_dashed)
hline(50, "Neutral Boundary", color.new(color.gray, 50), hline.style_solid)
hline(20, "Strong Bear / Exhaustion", color.new(color.red, 50), hline.style_dashed)

// =========================================================================
// SECTION 6: THE EXPERT PANEL TRADE ENGINE (STATE MACHINE)
// =========================================================================

var int trade_state = 0 // 1 = Long, -1 = Short, 0 = Flat (Take Profit)

bopen = ta.linreg(open, 11, 0)
bclose = ta.linreg(close, 11, 0)
hull = HMA(close, 55)

yellow_above_blue = grand_composite > composite_ma
white_above_green = kWeighted > dLine
vwap_slope = math.abs(daily_vwap - daily_vwap[1])
vwap_flattening = vwap_slope < vwap_slope[1]

// --- GAP BREAKOUT TRIGGERS (The Final Timing mechanism) ---
frama_long_trigger = ta.crossover(normalized_score, frama_upper) and signal_frama > signal_frama[2]
frama_short_trigger = ta.crossunder(normalized_score, frama_lower) and signal_frama < signal_frama[2]

// --- AI ADVANCED INSIGHT FILTERS ---
bb_width = (ta.sma(close, 20) + 2 * ta.stdev(close, 20)) - (ta.sma(close, 20) - 2 * ta.stdev(close, 20))
keltner_width = 2 * ta.atr(20)
is_squeeze = bb_width < keltner_width 
squeeze_firing = is_squeeze[1] and not is_squeeze 

vol_surge = volume > ta.sma(volume, 20) * 1.5

price_lower_low = close < ta.lowest(close, 20)[1]
score_higher_low = normalized_score > ta.lowest(normalized_score, 20)[1]
bull_div = price_lower_low and score_higher_low

price_higher_high = close > ta.highest(close, 20)[1]
score_lower_high = normalized_score < ta.highest(normalized_score, 20)[1]
bear_div = price_higher_high and score_lower_high

// --- THE SETUPS (With 3-5 Bar "Armed" Memory) ---

// 1. Bullish Continuation (Breakout)
bull_cont = (bclose > bopen or close > open) and close > pd_val and close > hull and close > daily_vwap and close > bclose and close > pd_vwap and yellow_above_blue and white_above_green and not vix_exhaustion_bull
recent_vol_or_squeeze = ta.barssince(squeeze_firing or vol_surge) <= 3
bull_breakout = bull_cont and recent_vol_or_squeeze and frama_long_trigger

// 2. The Golden Pullback (Mean Reversion in a Bull Trend)
near_vwap_support = math.abs(close - daily_vwap) / daily_vwap < 0.003
recent_vwap_bounce = ta.barssince(near_vwap_support and ta.crossover(kWeighted, dLine) and kWeighted < 40) <= 5
golden_pullback_long = yellow_above_blue and recent_vwap_bounce and frama_long_trigger

// 3. Bullish Reversal (Falling Knife Protection)
near_l3 = close <= L3 + (H3 - L3) * 0.15
bull_rev = near_l3 and vwap_flattening and ta.crossover(close, bclose) and close < hull and ta.crossover(kWeighted, dLine) and yellow_above_blue
recent_bull_div = ta.barssince(bull_div) <= 5
safe_bull_rev = bull_rev and recent_bull_div and frama_long_trigger

// --- Bearish Counterparts ---
bear_cont = (bclose < bopen or close < open) and close < pd_vah and close < hull and close < daily_vwap and close < bclose and close < pd_vwap and not yellow_above_blue and not white_above_green and not vix_exhaustion_bear
recent_bear_surge = ta.barssince(squeeze_firing or vol_surge) <= 3
bear_breakdown = bear_cont and recent_bear_surge and frama_short_trigger

near_vwap_resist = math.abs(close - daily_vwap) / daily_vwap < 0.003
recent_vwap_reject = ta.barssince(near_vwap_resist and ta.crossunder(kWeighted, dLine) and kWeighted > 60) <= 5
golden_pullback_short = not yellow_above_blue and recent_vwap_reject and frama_short_trigger

near_h3 = close >= H3 - (H3 - L3) * 0.15
bear_rev = near_h3 and vwap_flattening and ta.crossunder(close, bclose) and close > hull and ta.crossunder(kWeighted, dLine) and not yellow_above_blue
recent_bear_div = ta.barssince(bear_div) <= 5
safe_bear_rev = bear_rev and recent_bear_div and frama_short_trigger

// --- STATE MACHINE & DYNAMIC EXITS ---
bool fire_long = false
bool fire_short = false
bool fire_exit = false

// Dynamic Take Profit (Exits when exhaustion triggers to preserve capital)
if trade_state == 1 and (vix_exhaustion_bull or ta.crossunder(normalized_score, 80))
    trade_state := 0
    fire_exit := true

if trade_state == -1 and (vix_exhaustion_bear or ta.crossover(normalized_score, 20))
    trade_state := 0
    fire_exit := true

// Entries (Locked until exit or reversal)
if (bull_breakout or safe_bull_rev or golden_pullback_long) and trade_state != 1
    trade_state := 1
    fire_long := true

if (bear_breakdown or safe_bear_rev or golden_pullback_short) and trade_state != -1
    trade_state := -1
    fire_short := true

// --- Signal Plotting ---
plotshape(fire_long, title="Long Signal", text="▲ LONG", style=shape.labelup, location=location.bottom, color=color.lime, textcolor=color.black, size=size.small)
plotshape(fire_short, title="Short Signal", text="▼ SHORT", style=shape.labeldown, location=location.top, color=color.red, textcolor=color.white, size=size.small)
plotshape(fire_exit, title="Exit Signal", text="◆ EXIT", style=shape.diamond, location=location.bottom, color=color.orange, textcolor=color.white, size=size.small)

// --- Dashboard Readout ---
var table tbl = table.new(position.top_right, 2, 2, border_width = 1, border_color=color.new(color.gray, 50))
if barstate.islast
    table.cell(tbl, 0, 0, "MASTER SCORE", text_color=color.white, bgcolor=color.black)
    table.cell(tbl, 1, 0, str.tostring(normalized_score, "#.00"), text_color=color.white, bgcolor=gap_color)
    table.cell(tbl, 0, 1, "State Engine", text_color=color.white, bgcolor=color.black)
    state_txt = trade_state == 1 ? "LONG ACTIVE" : trade_state == -1 ? "SHORT ACTIVE" : "FLAT (WAITING)"
    table.cell(tbl, 1, 1, state_txt, text_color=color.white, bgcolor=trade_state == 1 ? color.lime : trade_state == -1 ? color.red : color.gray)
