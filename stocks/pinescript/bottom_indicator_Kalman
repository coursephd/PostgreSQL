kalmanLength = input.int(11, "Kalman Length (Velocity)", minval=1, group=grp_vel)

// ────────────────────────────────────────────────
// Kalman Filter Implementation
// ────────────────────────────────────────────────
f_kalman(src, base_length) =>
    float gain = 2.0 / (math.max(base_length, 1.0) + 1.0)
    if useKalman and useAdaptive
        vol_ma = ta.sma(volume, 20)
        rvol = vol_ma > 0 ? volume / vol_ma : 1.0
        rvol_capped = math.max(0.5, math.min(rvol, 2.5)) // Cap RVOL between 0.5x and 2.5x
        adaptive_length = math.max(1.0, base_length / rvol_capped)
        gain := 2.0 / (adaptive_length + 1.0)

    // Use critically damped parameters to prevent overshoot (ringing)
    float alpha = math.min(math.max(gain, 0.001), 0.999)
    float beta = 2.0 - alpha - 2.0 * math.sqrt(1.0 - alpha)

    var float kf = na
    var float velo = 0.0
    if na(kf)
        kf := src
    else
        dk = src - nz(kf[1], src)
        smooth = nz(kf[1], src) + alpha * dk
        velo := nz(velo[1], 0.0) + beta * dk
        kf := smooth + velo
    kf

f_kalman_kinematics(src, base_length) =>
    float gain = 2.0 / (math.max(base_length, 1.0) + 1.0)
    if useAdaptive
        vol_ma = ta.sma(volume, 20)
        rvol = vol_ma > 0 ? volume / vol_ma : 1.0
        rvol_capped = math.max(0.5, math.min(rvol, volCap))
        adaptive_length = math.max(1.0, base_length / rvol_capped)
        gain := 2.0 / (adaptive_length + 1.0)
    float alpha = math.min(math.max(gain, 0.001), 0.999)
    beta = 2 - alpha - 2 * math.sqrt(1 - alpha)
    var float kf = na
    var float velo = 0.0
    if na(kf)
        kf := src
    else
        dk = src - nz(kf[1], src)
        smooth = nz(kf[1], src) + alpha * dk
        velo := nz(velo[1], 0.0) + beta * dk
        kf := smooth + velo
    [kf, velo]

// ────────────────────────────────────────────────
// Helper Function: The MTF Composite Trend Score Logic
// Applied dynamically to any volume line (OBV, MFI, etc.)
// ────────────────────────────────────────────────
evaluate_line_trend(val) =>
    // 1. Trend Direction of the Indicator Line
    sma50 = ta.sma(val, 50)
    trend = val > sma50 ? 1 : val < sma50 ? -1 : 0

    score = 0.0
    // Evaluate stateful functions OUTSIDE the if-block to prevent buffer inconsistencies
    ph = ta.pivothigh(val, 5, 5)
    pl = ta.pivotlow(val, 5, 5)
    ph0 = ta.valuewhen(not na(ph), ph, 0)
    ph1 = ta.valuewhen(not na(ph), ph, 1)
    pl0 = ta.valuewhen(not na(pl), pl, 0)
    pl1 = ta.valuewhen(not na(pl), pl, 1)

    // And RSI divergence
    val_rsi = ta.rsi(val, 14)
    rsi_ph0 = ta.valuewhen(not na(ph), val_rsi[5], 0)
    rsi_ph1 = ta.valuewhen(not na(ph), val_rsi[5], 1)
    rsi_pl0 = ta.valuewhen(not na(pl), val_rsi[5], 0)
    rsi_pl1 = ta.valuewhen(not na(pl), val_rsi[5], 1)

    if trend != 0
        // Pillar 1: Structure (Staircase / Continuation)
        staircase_up = not na(ph0) and not na(ph1) and not na(pl0) and not na(pl1) and ph0 > ph1 and pl0 > pl1
        staircase_down = not na(ph0) and not na(ph1) and not na(pl0) and not na(pl1) and ph0 < ph1 and pl0 < pl1
        if (trend == 1 and staircase_up) or (trend == -1 and staircase_down)
            score += 1.0

        no_break_up = not na(ph0) and not na(ph1) and ph0 > ph1
        no_break_down = not na(pl0) and not na(pl1) and pl0 < pl1
        if (trend == 1 and no_break_up) or (trend == -1 and no_break_down)
            score += 1.0

        // Pillar 2: Momentum (Rising/Falling Fast Average of the Line)
        fast_sma = ta.sma(val, 10)
        rising_sma = ta.rising(fast_sma, 3)
        falling_sma = ta.falling(fast_sma, 3)
        if (trend == 1 and rising_sma) or (trend == -1 and falling_sma)
            score += 1.0

        // Pillar 3: No Exhaustion (RSI Divergence on the indicator line itself)
        bear_div = not na(ph1) and ph0 > ph1 and rsi_ph0 < rsi_ph1
        bull_div = not na(pl1) and pl0 < pl1 and rsi_pl0 > rsi_pl1
        if (trend == 1 and not bear_div) or (trend == -1 and not bull_div)
            score += 1.0

    // Return final signed score for this specific indicator
    score * trend

// ────────────────────────────────────────────────
// Calculate the 6 Parameters and Score them
// ────────────────────────────────────────────────
calc_tf_score() =>
    // Parameter 1: OBV (On-Balance Volume)
    s1 = evaluate_line_trend(ta.obv)

    // Parameter 2: Classic A/D (Accumulation/Distribution)
    s2 = evaluate_line_trend(ta.accdist)

    // Parameter 3: Williams A/D
    curr_ad = close > nz(close[1]) ? close - math.min(low, nz(close[1])) : close < nz(close[1]) ? close - math.max(high, nz(close[1])) : 0.0
    wad = ta.cum(curr_ad)
    s3 = evaluate_line_trend(wad)

    // Parameter 4: Money Flow Index (MFI)
    s4 = evaluate_line_trend(ta.mfi(close, 14))

    // Parameter 5: Chaikin Money Flow (CMF logic)
    mf_mult = (high != low) ? ((close - low) - (high - close)) / (high - low) : 0.0
    cmf = math.sum(mf_mult * volume, 20) / math.sum(volume, 20)
    s5 = evaluate_line_trend(cmf)

    // Parameter 6: Wyckoff Effort vs Result (Synthetic Cumulative Line)
    vol_ma = ta.sma(volume, 20)
    body = math.abs(close - open)
    body_ma = ta.sma(body, 20)
    w_dir = 0.0
    if volume > vol_ma * 1.5 and body < body_ma * 0.8
        w_dir := close > (high + low) / 2 ? 1.0 : -1.0
    wyckoff = ta.cum(w_dir * volume)
    s6 = evaluate_line_trend(wyckoff)

    // Parameter 7: close price
    s7 = evaluate_line_trend(close)

    // Combine the 7 individual parameter scores into 1 unified score for this timeframe
    s1 + s2 + s3 + s4 + s5 + s6 + s7

// ────────────────────────────────────────────────
// Multi-Timeframe Aggregation (Combine all TF scores into 1 Grand Composite)
// ────────────────────────────────────────────────
tfs = array.from("1", "3", "5", "15", "30", "60", "240", "D")

grand_composite = 0.0
composite_s7 = 0.0
for i = 0 to array.size(tfs) - 1
    tf = array.get(tfs, i)
    // Runs the entire 7-parameter trend logic within the context of the specific timeframe
    score_tf = request.security(syminfo.tickerid, tf, calc_tf_score())
    grand_composite += nz(score_tf, 0)
    composite_s7 += nz(score_tf, 0)

