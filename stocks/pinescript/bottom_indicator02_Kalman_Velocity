// bottom_indicator02_Kalman_Velocity as of 21st May 2026

// VinAI MTF Grand Composite Velocity & Acceleration
//@version=6
indicator("MTF Composite Kalman Velocity", shorttitle="MTF Vel K", overlay=false)

// ────────────────────────────────────────────────
// Inputs
// ────────────────────────────────────────────────
grp_main = "Kalman Settings"
displayMode = input.string("RSI of Velocity", "Display Mode", options=["Raw Velocity", "RSI of Velocity"], group=grp_main)
length = input.int(11, "Kalman Length", minval=1, group=grp_main)
useAdaptive = input.bool(true, "Use Volume-Adaptive", group=grp_main)
volCap = input.float(2.5, "Max Volume Cap", step=0.1, group=grp_main)

grp_wma = "WMA & RSI Settings"
rsiLen = input.int(14, "Velocity RSI Length", minval=1, group=grp_wma)
wmaLen = input.int(13, "Signal WMA Length", minval=1, group=grp_wma)

grp_visual = "Visuals"
colorVeloUp = input.color(#00E676, "Primary Rising", group=grp_visual)
colorVeloDn = input.color(#FF5252, "Primary Falling", group=grp_visual)
colorWma = input.color(color.yellow, "Signal WMA", group=grp_visual)
colorAccUp = input.color(color.new(#00B0FF, 50), "Acceleration Positive", group=grp_visual)
colorAccDn = input.color(color.new(#FF4081, 50), "Acceleration Negative", group=grp_visual)

// ────────────────────────────────────────────────
// MTF Composite Logic
// ────────────────────────────────────────────────
evaluate_line_trend(val) =>
    sma50 = ta.sma(val, 50)
    trend = val > sma50 ? 1 : val < sma50 ? -1 : 0
    score = 0.0
    if trend != 0
        ph = ta.pivothigh(val, 5, 5)
        pl = ta.pivotlow(val, 5, 5)
        ph0 = ta.valuewhen(not na(ph), ph, 0)
        ph1 = ta.valuewhen(not na(ph), ph, 1)
        pl0 = ta.valuewhen(not na(pl), pl, 0)
        pl1 = ta.valuewhen(not na(pl), pl, 1)

        // Pillar 1: Structure
        if (trend == 1 and not na(ph0) and not na(ph1) and not na(pl0) and not na(pl1) and ph0 > ph1 and pl0 > pl1) or (trend == -1 and not na(ph0) and not na(ph1) and not na(pl0) and not na(pl1) and ph0 < ph1 and pl0 < pl1)
            score += 1.0
        if (trend == 1 and not na(ph0) and not na(ph1) and ph0 > ph1) or (trend == -1 and not na(pl0) and not na(pl1) and pl0 < pl1)
            score += 1.0

        // Pillar 2: Momentum
        fast_sma = ta.sma(val, 10)
        if (trend == 1 and ta.rising(fast_sma, 3)) or (trend == -1 and ta.falling(fast_sma, 3))
            score += 1.0

        // Pillar 3: RSI Divergence
        val_rsi = ta.rsi(val, 14)
        rsi_ph0 = ta.valuewhen(not na(ph), val_rsi[5], 0)
        rsi_ph1 = ta.valuewhen(not na(ph), val_rsi[5], 1)
        rsi_pl0 = ta.valuewhen(not na(pl), val_rsi[5], 0)
        rsi_pl1 = ta.valuewhen(not na(pl), val_rsi[5], 1)
        bear_div = not na(ph1) and ph0 > ph1 and rsi_ph0 < rsi_ph1
        bull_div = not na(pl1) and pl0 < pl1 and rsi_pl0 > rsi_pl1
        if (trend == 1 and not bear_div) or (trend == -1 and not bull_div)
            score += 1.0

    score * trend

calc_tf_score() =>
    s1 = evaluate_line_trend(ta.obv)
    s2 = evaluate_line_trend(ta.accdist)
    curr_ad = close > nz(close[1]) ? close - math.min(low, nz(close[1])) : close < nz(close[1]) ? close - math.max(high, nz(close[1])) : 0.0
    s3 = evaluate_line_trend(ta.cum(curr_ad))
    s4 = evaluate_line_trend(ta.mfi(close, 14))
    mf_mult = (high != low) ? ((close - low) - (high - close)) / (high - low) : 0.0
    cmf = math.sum(mf_mult * volume, 20) / math.sum(volume, 20)
    s5 = evaluate_line_trend(cmf)
    vol_ma = ta.sma(volume, 20)
    body = math.abs(close - open)
    body_ma = ta.sma(body, 20)
    w_dir = (volume > vol_ma * 1.5 and body < body_ma * 0.8) ? (close > (high + low) / 2 ? 1.0 : -1.0) : 0.0
    s6 = evaluate_line_trend(ta.cum(w_dir * volume))
    s7 = evaluate_line_trend(close)
    s1 + s2 + s3 + s4 + s5 + s6 + s7

tfs = array.from("1", "3", "5", "15", "30", "60", "240", "D")
grand_composite = 0.0
for i = 0 to array.size(tfs) - 1
    tf = array.get(tfs, i)
    score_tf = request.security(syminfo.tickerid, tf, calc_tf_score())
    grand_composite += nz(score_tf, 0)

// ────────────────────────────────────────────────
// Kalman Kinematics Function
// ────────────────────────────────────────────────
f_kalman_kinematics(src, base_length) =>
    float gain = 2.0 / (math.max(base_length, 1.0) + 1.0)
    if useAdaptive
        vol_ma = ta.sma(volume, 20)
        rvol = vol_ma > 0 ? volume / vol_ma : 1.0
        rvol_capped = math.max(0.5, math.min(rvol, volCap))
        adaptive_length = math.max(1.0, base_length / rvol_capped)
        gain := 2.0 / (adaptive_length + 1.0)
        
    float alpha = math.min(math.max(gain, 0.001), 0.999)
    float beta = 2.0 - alpha - 2.0 * math.sqrt(1.0 - alpha)
        
    var float kf = na
    var float velo = 0.0
    if na(kf)
        kf := src
    else
        dk = src - nz(kf[1], src)
        smooth = nz(kf[1], src) + alpha * dk
        velo := nz(velo[1], 0.0) + beta * dk
        kf := smooth + velo
    [kf, velo]

// ────────────────────────────────────────────────
// Calculations
// ────────────────────────────────────────────────
// Feed the Grand Composite into the Kalman Kinematics!
[kf_line, velocity] = f_kalman_kinematics(grand_composite, length)

isRaw = displayMode == "Raw Velocity"

// Raw Calculations
raw_acc = velocity - nz(velocity[1])
raw_wma = ta.wma(velocity, wmaLen)

// RSI Calculations
velo_rsi = ta.rsi(velocity, rsiLen)
rsi_acc = velo_rsi - nz(velo_rsi[1])
rsi_wma = ta.wma(velo_rsi, wmaLen)

// Select active data based on mode
active_main = isRaw ? velocity : velo_rsi
active_wma = isRaw ? raw_wma : rsi_wma
active_acc = isRaw ? raw_acc : rsi_acc
active_mid = isRaw ? 0 : 50

// Smooth acceleration slightly for histograms
acc_smooth = ta.ema(active_acc, 3)

// ────────────────────────────────────────────────
// Visual Logic & Plotting
// ────────────────────────────────────────────────
main_rising = active_main > nz(active_main[1])
main_color = main_rising ? colorVeloUp : colorVeloDn
acc_color = acc_smooth > 0 ? colorAccUp : colorAccDn

plot(acc_smooth, title="Acceleration Histogram", style=plot.style_columns, color=acc_color)
plot(active_main, title="Primary Line", color=main_color, linewidth=2)
plot(active_wma, title="Signal WMA", color=colorWma, linewidth=1)

hline(active_mid, "Mid Line", color=color.new(color.gray, 50), linestyle=hline.style_dashed, linewidth=1)
hline(isRaw ? na : 80, "Overbought", color=color.new(color.red, 30), linestyle=hline.style_dotted, linewidth=2)
hline(isRaw ? na : 20, "Oversold", color=color.new(color.green, 30), linestyle=hline.style_dotted, linewidth=2)

acc_cross_down = ta.crossunder(acc_smooth, 0) and active_main > active_mid
acc_cross_up = ta.crossover(acc_smooth, 0) and active_main < active_mid

plotshape(acc_cross_down ? active_main : na, title="Bull Exhaustion", style=shape.triangledown, location=location.absolute, color=color.red, size=size.tiny, text="EX", textcolor=color.red)
plotshape(acc_cross_up ? active_main : na, title="Bear Exhaustion", style=shape.triangleup, location=location.absolute, color=color.green, size=size.tiny, text="EX", textcolor=color.green)
