show_monthly = input.bool(true, "Show Monthly Pivot", group=group_htf)

group_gpz    = "GPZ & Neutral Colors"
gpz_top_col  = input.color(color.new(color.yellow, 30), "GPZ Top Half", group=group_gpz)
gpz_bot_col  = input.color(color.new(color.red, 40), "GPZ Bottom Half", group=group_gpz)
neutral_col  = input.color(color.new(color.red, 80), "Neutral (TC=BC)", group=group_gpz)

// ── CALCULATIONS: CORE LOGIC (V6 ADAPTATION) ─────────────────────────────
// Fetching [High, Low, Close] for Today (Prev Day Data)
[ph, pl, pc] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)

// Fetching [High, Low, Close] for Tomorrow (Live Today Data)
[th, tl, tc_live] = request.security(syminfo.tickerid, "D", [high, low, close], lookahead=barmerge.lookahead_on)

// 1. TODAY'S FIXED CPR (from ph, pl, pc)
pivot = (ph + pl + pc) / 3.0
bc    = (ph + pl) / 2.0
tc    = pivot - bc + pivot
c_mid = (tc + bc) / 2.0

// 2. TODAY'S FIXED CAMARILLA
range_fixed = ph - pl
H5 = (ph / pl) * pc
H4 = pc + range_fixed * 1.1 / 2
H3 = pc + range_fixed * 1.1 / 4
L3 = pc - range_fixed * 1.1 / 4
L4 = pc - range_fixed * 1.1 / 2
L5 = pc - (H5 - pc)

// 3. HTF PIVOTS (Weekly/Monthly)
wp = request.security(syminfo.tickerid, "W", (high[1] + low[1] + close[1]) / 3, lookahead=barmerge.lookahead_on)
mp = request.security(syminfo.tickerid, "M", (high[1] + low[1] + close[1]) / 3, lookahead=barmerge.lookahead_on)

// 4. TOMORROW'S DEVELOPING (from th, tl, tc_live)
n_p   = (th + tl + tc_live) / 3.0
n_bc  = (th + tl) / 2.0
n_tc  = n_p - n_bc + n_p
n_h3  = tc_live + (th - tl) * 1.1 / 4
n_h4  = tc_live + (th - tl) * 1.1 / 2

n_l3  = tc_live - (th - tl) * 1.1 / 4
n_l4  = tc_live - (th - tl) * 1.1 / 2

// ── LOGIC: NEUTRAL & GPZ (CURRENT DAY) ────────────────────────────────────
is_neutral = (tc == bc)
is_gpz     = (L3 >= math.min(bc, tc) and L3 <= math.max(bc, tc)) or (H3 >= math.min(bc, tc) and H3 <= math.max(bc, tc))

// ── PLOTS: TODAY FIXED (Global Scope) ─────────────────────────────────────
p_tc  = plot(show_cpr ? tc : na, "CPR TC", cpr_color)
p_mid = plot(show_cpr ? c_mid : na, "CPR Mid", color.new(color.white, 100))
p_bc  = plot(show_cpr ? bc : na, "CPR BC", cpr_color)
plot(show_cpr ? pivot : na, "CPR Pivot", cpr_color, 2)

fill(p_tc, p_mid, is_gpz ? gpz_top_col : is_neutral ? neutral_col : color.new(cpr_color, 85))
fill(p_mid, p_bc, is_gpz ? gpz_bot_col : is_neutral ? neutral_col : color.new(cpr_color, 85))

plot(show_cam ? H5 : na, "H5", r_color, 2)
plot(show_cam ? H4 : na, "H4", r_color, 2)
plot(show_cam ? H3 : na, "H3", r_color, 1)
plot(show_cam ? L3 : na, "L3", s_color, 1)
plot(show_cam ? L4 : na, "L4", s_color, 1)
plot(show_cam ? L5 : na, "L5", s_color, 2)

plot(ph, "PDH", color.white, 1, plot.style_linebr)
plot(pl, "PDL", color.white, 1, plot.style_linebr)

// HTF Plots
plot(show_weekly  ? wp : na, "Weekly Pivot", color.blue, 2, plot.style_stepline)
plot(show_monthly ? mp : na, "Monthly Pivot", color.fuchsia, 2, plot.style_stepline)

// ── NEXT-DAY DYNAMIC PREVIEW (CLEAN HORIZONTAL) ───────────────────────────
// Use varip for drawing objects that update on the last bar
var line[] previewLines = array.new_line()
var label[] previewLabels = array.new_label()

if barstate.islast
    // Clear previous drawings to prevent overlap
    if array.size(previewLines) > 0
        for i = 0 to array.size(previewLines) - 1
            line.delete(array.get(previewLines, i))
        array.clear(previewLines)
    if array.size(previewLabels) > 0
        for i = 0 to array.size(previewLabels) - 1
            label.delete(array.get(previewLabels, i))
        array.clear(previewLabels)
        
    sz = get_size(label_size)
    int start = bar_index
    int end   = bar_index + future_off

    // Draw Tomorrow's Horizontal Preview & Store in Array
    array.push(previewLines, f_next(start, n_tc, end, color.new(cpr_color, 50), 1))
    array.push(previewLines, f_next(start, n_p,  end, color.new(cpr_color, 50), 2))
    array.push(previewLines, f_next(start, n_bc, end, color.new(cpr_color, 50), 1))
    array.push(previewLines, f_next(start, n_h3, end, color.new(r_color, 50), 1))
    array.push(previewLines, f_next(start, n_h4, end, color.new(r_color, 50), 1))
    array.push(previewLines, f_next(start, n_l3, end, color.new(s_color, 50), 1))
    array.push(previewLines, f_next(start, n_l4, end, color.new(s_color, 50), 1))
    array.push(previewLines, f_next(start, th,   end, color.new(color.white, 60), 1)) // Tomorrow's PDH
    array.push(previewLines, f_next(start, tl,   end, color.new(color.white, 60), 1)) // Tomorrow's PDL

    // Current Labels
    array.push(previewLabels, f_lab(start, tc, "TC", cpr_color, color.white, sz))
    array.push(previewLabels, f_lab(start, pivot, "P", cpr_color, color.white, sz))
    array.push(previewLabels, f_lab(start, bc, "BC", cpr_color, color.white, sz))
    array.push(previewLabels, f_lab(start, ph, "PDH", color.white, color.black, sz))
    array.push(previewLabels, f_lab(start, pl, "PDL", color.white, color.black, sz))
    if show_weekly
        array.push(previewLabels, f_lab(start, wp, "WP", color.blue, color.white, sz))
    if show_monthly
        array.push(previewLabels, f_lab(start, mp, "MP", color.fuchsia, color.white, sz))

    // Tomorrow Labels
    array.push(previewLabels, f_lab(end, n_tc, "Next TC", cpr_color, color.black, sz))
    array.push(previewLabels, f_lab(end, n_bc, "Next BC", cpr_color, color.black, sz))
    array.push(previewLabels, f_lab(end, n_p,  "Next P",  cpr_color, color.black, sz))
    array.push(previewLabels, f_lab(end, n_h3, "Next H3", r_color, color.black, sz))
    array.push(previewLabels, f_lab(end, n_h4, "Next H4", r_color, color.black, sz))
    array.push(previewLabels, f_lab(end, n_l3, "Next L3", s_color, color.black, sz))
    array.push(previewLabels, f_lab(end, n_l4, "Next L4", s_color, color.black, sz))
    array.push(previewLabels, f_lab(end, th,   "Next PDH", color.white, color.black, sz))
    array.push(previewLabels, f_lab(end, tl,   "Next PDL", color.white, color.black, sz))

    // ONGOING DAY OFFSET LABELS (Placed at Current Bar)
    if show_cam
        array.push(previewLabels, f_lab(start, H5, "H5", r_color, color.black, sz))
        array.push(previewLabels, f_lab(start, H4, "H4", r_color, color.black, sz))
        array.push(previewLabels, f_lab(start, H3, "H3", r_color, color.black, sz))
        array.push(previewLabels, f_lab(start, L3, "L3", s_color, color.black, sz))
        array.push(previewLabels, f_lab(start, L4, "L4", s_color, color.black, sz))
        array.push(previewLabels, f_lab(start, L5, "L5", s_color, color.black, sz))
