var float tvapCumTime = 0.0
var float yest_TVAP = na

if isNewDay()
    yest_TVAP := tvapCumTime > 0 ? tvapCumSum / tvapCumTime : na
    tvapCumSum := 0.0
    tvapCumTime := 0.0
    tvapCumTime

