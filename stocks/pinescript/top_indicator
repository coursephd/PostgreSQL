// ────────────────────────────────────────────────
// Helpers
isNewDay() =>
    ta.change(time('D')) != 0

// ────────────────────────────────────────────────
// Persistent variables (hold yesterday's final values)
var float yest_VWAP = na
var float yest_StDev = na
var float yest_Upper1SD = na
var float yest_Lower1SD = na

// ────────────────────────────────────────────────
// Current-day accumulators (reset at new day)
var float cumPV = 0.0 // ∑ (price × volume)
var float cumVol = 0.0 // ∑ volume
var float cumPV2 = 0.0 // ∑ (price² × volume)  ← for variance

// Reset & store yesterday's final values when new day begins
if isNewDay()
    if cumVol > 0
        float vwap_temp = cumPV / cumVol

        // Volume-weighted variance = E[X²] - (E[X])²
        float variance = cumPV2 / cumVol - math.pow(vwap_temp, 2)
        float stdev = variance > 0 ? math.sqrt(variance) : 0.0

        // Store for plotting across the whole current day
        yest_VWAP := vwap_temp
        yest_StDev := stdev
        yest_Upper1SD := vwap_temp + stdev
        yest_Lower1SD := vwap_temp - stdev
        yest_Lower1SD

    // Reset accumulators for the new day
    cumPV := 0.0
    cumVol := 0.0
    cumPV2 := 0.0
    cumPV2

// ────────────────────────────────────────────────
// Accumulate on every bar (current day)
cumPV := cumPV + close * volume
cumVol := cumVol + volume
cumPV2 := cumPV2 + math.pow(close, 2) * volume // or use hlc3 if preferred: math.pow(hlc3,2)*volume

// ────────────────────────────────────────────────
// Plots ───────────────────────────────────────────
plot(yest_VWAP, 'Yesterday VWAP', color.blue, linewidth = 2)

// ±1 SD bands — dotted, lighter blue
plot(yest_Upper1SD, 'Yesterday VWAP +1σ', color.new(color.blue, 30), style = plot.style_linebr, linewidth = 2)
plot(yest_Lower1SD, 'Yesterday VWAP -1σ', color.new(color.blue, 30), style = plot.style_linebr, linewidth = 2)

// Optional: subtle fill between bands
// fill(yest_Upper1SD, yest_Lower1SD, color.new(color.blue, 92), title="±1σ zone")

