// --- FUNCTIONS ---
// HMA: Hull Moving Average
HMA(_src, _length) => 
    ta.wma(2 * ta.wma(_src, _length / 2) - ta.wma(_src, _length), math.round(math.sqrt(_length)))

// EHMA: Exponential Hull Moving Average
EHMA(_src, _length) => 
    ta.ema(2 * ta.ema(_src, _length / 2) - ta.ema(_src, _length), math.round(math.sqrt(_length)))

// THMA: Triple Hull Moving Average
THMA(_src, _length) => 
    ta.wma(ta.wma(_src, _length / 3) * 3 - ta.wma(_src, _length / 2) - ta.wma(_src, _length), _length)

// --- LOGIC ---
Mode(mode, _src, len) =>
    switch mode
        "Hma"  => HMA(_src, len)
        "Ehma" => EHMA(_src, len)
        "Thma" => THMA(_src, len / 2)
        => na

HULL = Mode(modeSwitch, src_hull, length)

// Color Logic
hullColor = switchColor ? (HULL > HULL[2] ? color.new(#00ff00, 0) : color.new(#ff0000, 0)) : color.new(#ff9800, 0)
bandColor = color.new(hullColor, transpSwitch)

// --- PLOTTING ---
// Main Line
p1 = plot(showHull ? HULL : na, "Hull MA", color=hullColor, linewidth=thicknessSwitch)

// Band Logic (using HULL[2] as the offset/shadow for the band)
p2 = plot(showHull and visualSwitch ? HULL[2] : na, "Hull Shadow", color=hullColor, display=display.none)

fill(p1, p2, color=showHull and visualSwitch ? bandColor : na, title="Hull Band")


