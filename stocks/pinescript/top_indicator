//                                                                                        //
// Section 6                                                                              //
//                                                                                        //
// Create VIX based bands                                                                 //
// Create a pinescript code in v6.0                                                       //
//                                                                                        //
// Use india vix on nse                                                                   //
// Pick up yesterday close Divide that number by 19.1 (SQRT 365 days),                    //
// Convert to a percent value                                                             //
// Use yesterday’s close price for the symbol and multiply the above number               //
// Add this number and print a dotted green line on next day’s time for whole day         //
// Add 2 another green dotted lines at 1.25 and 0.5 times of                              //
// the same number added to the close price                                               //
// Do similar calculations for downside and print them red                                //
// If the price is already crossing these boundries add 1.5 and 1.75 multipliers optionally
// Provide an option to Delete older lines say 5 or more days older                       //
//                                                                                        //
////////////////////////////////////////////////////////////////////////////////////////////
// --- Inputs ---
vix_symbol      = input.string("NSE:INDIAVIX", "VIX Symbol")
days_to_keep    = input.int(5, "Days to Keep Lines", minval = 1)
show_extensions = input.bool(true, "Show 1.5 & 1.75 Extensions")

// --- Fetch Data ---
vix_close  = request.security(vix_symbol, "D", close[1], lookahead = barmerge.lookahead_on)
prev_close = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)

// --- Calculations ---
base_val     = vix_close / 19.1
price_offset = prev_close * (base_val / 100)

m_025 = 0.25 * price_offset
m_050 = 0.50 * price_offset
m_100 = 1.00 * price_offset
m_125 = 1.25 * price_offset
m_150 = 1.50 * price_offset
m_175 = 1.75 * price_offset

// --- Global Arrays ---
var line[] all_lines  = array.new_line()
var label[] all_lbls  = array.new_label()

// --- Function to Create Lines & Labels ---
f_draw_line(price, col, txt) =>
    // Draw Line
    ln = line.new(x1 = bar_index, y1 = price, 
                  x2 = bar_index, y2 = price, 
                  style = line.style_dotted, color = col, width = 1)
    // Draw Label (style_none makes it just text)
    lb = label.new(x = bar_index, y = price, text = txt, 
                   textcolor = col, color = color.new(col, 100), 
                   style = label.style_label_left, size = size.small)
    
    array.push(all_lines, ln)
    array.push(all_lbls, lb)
    ln 

// --- New Day Logic ---
bool is_new_day = timeframe.change("D")

if is_new_day
    // Create standard 6 lines with labels
    f_draw_line(prev_close + m_025, color.green, "0.25")
    f_draw_line(prev_close + m_050, color.green, "0.5")
    f_draw_line(prev_close + m_100, color.green, "1.0")
    f_draw_line(prev_close + m_125, color.green, "1.25")
    f_draw_line(prev_close + m_025, color.red, "-0.25")
    f_draw_line(prev_close - m_050, color.red, "-0.5")
    f_draw_line(prev_close - m_100, color.red, "-1.0")
    f_draw_line(prev_close - m_125, color.red, "-1.25")

    if show_extensions
        f_draw_line(prev_close + m_150, color.new(color.green, 50), "1.5")
        f_draw_line(prev_close + m_175, color.new(color.green, 70), "1.75")
        f_draw_line(prev_close - m_150, color.new(color.red, 50), "-1.5")
        f_draw_line(prev_close - m_175, color.new(color.red, 70), "-1.75")

    // Cleanup Logic
    int lines_per_day = show_extensions ? 10 : 6
    if array.size(all_lines) > days_to_keep * lines_per_day
        for i = 1 to lines_per_day
            line.delete(array.shift(all_lines))
            label.delete(array.shift(all_lbls))

// --- Continuous Update ---
if array.size(all_lines) > 0
    int lines_to_update = show_extensions ? 10 : 6
    int loop_limit = math.min(lines_to_update, array.size(all_lines))
    for i = 0 to loop_limit - 1
        idx = array.size(all_lines) - 1 - i
        line.set_x2(array.get(all_lines, idx), bar_index)
        label.set_x(array.get(all_lbls, idx), bar_index)


