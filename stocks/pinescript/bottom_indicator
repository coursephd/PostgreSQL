rsi_s7_ma_ma = ta.wma(rsi_s7_ma, 21)

plot(rsi_s7_ma, title="RSI of Close composite ma", color=color.yellow, linewidth=2)
plot(rsi_s7_ma_ma, title="MA of RSI Close composite ma", color=color.blue, linewidth=2)

