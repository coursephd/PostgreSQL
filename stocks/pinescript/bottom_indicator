// Inputs
dlen = input.int(20, "Base Donchian Period", minval = 10)

// Helper function to get trend for a specific length
get_trend(len) =>
    var int trend = 0
    float hh = ta.highest(high, len)[1]
    float ll = ta.lowest(low, len)[1]
    trend := close > hh ? 1 : close < ll ? -1 : nz(trend)
    trend

// 1. Calculate Main Trend
maintrend = get_trend(dlen)

// 2. Aggregate Trends from 10 different periods (as in the original ribbon)
int agree_count = 0
for i = 0 to 9
    current_len = dlen - i
    if get_trend(current_len) == maintrend
        agree_count += 1

// 3. Dynamic Color Logic
// We map the 0-10 agreement count to a transparency level (0-100)
// Higher agreement = Lower transparency (more solid color)
int dynamic_transp = 100 - (agree_count * 7) // Scale from ~100 down to 30

color bg_color = na
if maintrend == 1
    bg_color := color.new(#006aff, dynamic_transp)
else if maintrend == -1
    bg_color := color.new(#ffae00, dynamic_transp)

// Output
bgcolor(bg_color)

