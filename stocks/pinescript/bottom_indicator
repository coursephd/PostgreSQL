// --- Inputs ---
stochLen = input.int(30, title="%K Length")
smoothK  = input.int(7, title="%K Smoothing")
smoothD  = input.int(6, title="%D Smoothing")
wmaLen   = input.int(21, title="WMA Period")

// --- Stochastic Calculation (30, 7, 6) ---
// Formula: (Close - Lowest Low) / (Highest High - Lowest Low)
// Display these on 200 scale
lowestLow = ta.lowest(low, stochLen)
highestHigh = ta.highest(high, stochLen)
kRaw = 100 * (close - lowestLow) / (highestHigh - lowestLow) + 100
kLine = ta.sma(kRaw, smoothK)
dLine = ta.sma(kLine, smoothD)

// --- 21 Period Weighted Average of %K ---
kWeighted = ta.wma(kLine, wmaLen)

// --- Plotting ---
plot(kLine, title="%K", color=color.white, linewidth=2)
plot(dLine, title="%D", color=color.red, linewidth=2)
plot(kWeighted, title="Weighted K", color=color.green, linewidth=2)    
hline(180, "Overbought", color=color.red, linestyle=hline.style_dashed)
hline(120, "Oversold", color=color.green, linestyle=hline.style_dashed)

