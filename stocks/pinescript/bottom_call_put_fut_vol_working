//@version=6
indicator("Wizard Grand Composite • 18-Strike OTM Wing Engine", shorttitle="Grand OTM Matrix", overlay=false, max_labels_count=500)

// ── Section 1: Inputs & Expiry Configurations ────────────────────
base_index    = input.string("NSE:BANKNIFTY", "Spot Index Symbol")
fut_ticker    = input.string("NSE:BANKNIFTY1!", "Continuous Futures Ticker")
strike_step   = input.int(100, "Strike Step", minval=1)
oi_smooth_len = input.int(5, "Futures OI Evaluation Lookback")
opt_expiry    = input.string("260526", "Active Expiry (YYMMDD)")

// 🔒 THE OTM WING INTERFACE: Hardcoded 18-Strike Matrix (9 OTM Puts + 9 OTM Calls)
strike_atm = input.string("48000", "ATM Strike Line")

// Negative Direction Steps (OTM Puts)
strike_m1  = input.string("47900", "OTM Put Step (-1)")
strike_m2  = input.string("47800", "OTM Put Step (-2)")
strike_m3  = input.string("47700", "OTM Put Step (-3)")
strike_m4  = input.string("47600", "OTM Put Step (-4)")
strike_m5  = input.string("47500", "OTM Put Step (-5)")
strike_m6  = input.string("47400", "OTM Put Step (-6)")
strike_m7  = input.string("47300", "OTM Put Step (-7)")
strike_m8  = input.string("47200", "OTM Put Step (-8)")
strike_m9  = input.string("47100", "OTM Put Step (-9)")

// Positive Direction Steps (OTM Calls)
strike_p1  = input.string("48100", "OTM Call Step (+1)")
strike_p2  = input.string("48200", "OTM Call Step (+2)")
strike_p3  = input.string("48300", "OTM Call Step (+3)")
strike_p4  = input.string("48400", "OTM Call Step (+4)")
strike_p5  = input.string("48500", "OTM Call Step (+5)")
strike_p6  = input.string("48600", "OTM Call Step (+6)")
strike_p7  = input.string("48700", "OTM Call Step (+7)")
strike_p8  = input.string("48800", "OTM Call Step (+8)")
strike_p9  = input.string("48900", "OTM Call Step (+9)")

// ── Section 2: Explicit Data Pipeline (Exactly 21 Global Flat Requests) ──
float spot_close = nz(request.security(base_index, "5", close))

string fut_oi_ticker = fut_ticker + "_OI"
float oi             = request.security(fut_oi_ticker, "5", close)
[o, h, l, c, v]      = request.security(fut_ticker, "5", [open, high, low, close, volume])

// Flat Hardcoded OTM Option Feeds (9 OTM Calls + 9 OTM Puts)
float c_v_atm = nz(request.security(base_index + opt_expiry + "C" + strike_atm, "5", volume))
float c_v_p1  = nz(request.security(base_index + opt_expiry + "C" + strike_p1, "5", volume))
float c_v_p2  = nz(request.security(base_index + opt_expiry + "C" + strike_p2, "5", volume))
float c_v_p3  = nz(request.security(base_index + opt_expiry + "C" + strike_p3, "5", volume))
float c_v_p4  = nz(request.security(base_index + opt_expiry + "C" + strike_p4, "5", volume))
float c_v_p5  = nz(request.security(base_index + opt_expiry + "C" + strike_p5, "5", volume))
float c_v_p6  = nz(request.security(base_index + opt_expiry + "C" + strike_p6, "5", volume))
float c_v_p7  = nz(request.security(base_index + opt_expiry + "C" + strike_p7, "5", volume))
float c_v_p8  = nz(request.security(base_index + opt_expiry + "C" + strike_p8, "5", volume))
float c_v_p9  = nz(request.security(base_index + opt_expiry + "C" + strike_p9, "5", volume))

float p_v_atm = nz(request.security(base_index + opt_expiry + "P" + strike_atm, "5", volume))
float p_v_m1  = nz(request.security(base_index + opt_expiry + "P" + strike_m1, "5", volume))
float p_v_m2  = nz(request.security(base_index + opt_expiry + "P" + strike_m2, "5", volume))
float p_v_m3  = nz(request.security(base_index + opt_expiry + "P" + strike_m3, "5", volume))
float p_v_m4  = nz(request.security(base_index + opt_expiry + "P" + strike_m4, "5", volume))
float p_v_m5  = nz(request.security(base_index + opt_expiry + "P" + strike_m5, "5", volume))
float p_v_m6  = nz(request.security(base_index + opt_expiry + "P" + strike_m6, "5", volume))
float p_v_m7  = nz(request.security(base_index + opt_expiry + "P" + strike_m7, "5", volume))
float p_v_m8  = nz(request.security(base_index + opt_expiry + "P" + strike_m8, "5", volume))
float p_v_m9  = nz(request.security(base_index + opt_expiry + "P" + strike_m9, "5", volume))

// Globally sum pure OTM data fields to protect indicator loops
float total_calls_vol  = c_v_atm + c_v_p1 + c_v_p2 + c_v_p3 + c_v_p4 + c_v_p5 + c_v_p6 + c_v_p7 + c_v_p8 + c_v_p9
float total_puts_vol   = p_v_atm + p_v_m1 + p_v_m2 + p_v_m3 + p_v_m4 + p_v_m5 + p_v_m6 + p_v_m7 + p_v_m8 + p_v_m9
float net_deriv_volume = v + total_calls_vol - total_puts_vol

// Continuous Futures Trend Tracking Logic
float fut_price_trend = ta.sma(ta.change(c), oi_smooth_len)
float fut_oi_trend    = ta.sma(ta.change(oi), oi_smooth_len)
// ✅ FIX: Fixed nested typo state variable track link reference
float fut_oi_sent     = fut_price_trend > 0 and fut_oi_trend > 0 ? 100.0 : fut_price_trend < 0 and fut_oi_trend > 0 ? 0.0 : fut_price_trend > 0 and fut_oi_trend < 0 ? 65.0 : fut_price_trend < 0 and fut_oi_trend < 0 ? 35.0 : 50.0

// ── Section 3: Universal Lookback Indicators ──
float clv_factor = (h == l) ? 0.0 : (((c - l) - (h - c)) / (h - l))
float wyk_tr     = math.max(h - l, math.max(math.abs(h - nz(c)), math.abs(l - nz(c))))

// ── Section 4: Trend Direction Scoring Matrix ──
f_matrix_core(int len_sma, int len_rsi, int r_mult, float mfi_val, float cmf_val, float wyk_val) =>
    float sma50 = ta.sma(c, len_sma)
    int trend = c > sma50 ? 1 : c < sma50 ? -1 : 0
    float score = 0.0
    if trend != 0
        int ph_l = 5 * r_mult
        float ph = ta.pivothigh(c, ph_l, ph_l), float pl = ta.pivotlow(c, ph_l, ph_l)
        float ph0 = ta.valuewhen(not na(ph), ph, 0), float ph1 = ta.valuewhen(not na(ph), ph, 1)
        float pl0 = ta.valuewhen(not na(pl), pl, 0), float pl1 = ta.valuewhen(not na(pl), pl, 1)
        if (trend == 1 and ph0 > ph1 and pl0 > pl1) or (trend == -1 and ph0 < ph1 and pl0 < pl1)
            score += 1.0
        if (trend == 1 and ph0 > ph1) or (trend == -1 and pl0 < pl1)
            score += 1.0
        if (trend == 1 and ta.rising(ta.sma(c, 10 * r_mult), 3 * r_mult)) or (trend == -1 and ta.falling(ta.sma(c, 10 * r_mult), 3 * r_mult))
            score += 1.0
        float rsi_val = ta.rsi(c, len_rsi)
        bool bear_div = ph0 > ph1 and ta.valuewhen(not na(ph), rsi_val, 0) < ta.valuewhen(not na(ph), rsi_val, 1)
        bool bull_div = pl0 < pl1 and ta.valuewhen(not na(pl), rsi_val, 0) > ta.valuewhen(not na(pl), rsi_val, 1)
        if (trend == 1 and not bear_div) or (trend == -1 and not bull_div)
            score += 1.0
    50.0 + (((score * trend) + (mfi_val > 50 ? 1.0 : -1.0) + (cmf_val > 0 ? 1.0 : -1.0) + (wyk_val > 0 ? 1.0 : -1.0)) * 12.5)

// ── Section 5: Replicated Lookback Pipelines ──
score5   = f_matrix_core(50, 14, 1, ta.mfi(c, 14), ta.sma(clv_factor * net_deriv_volume, 20) / math.max(ta.sma(net_deriv_volume, 20), 1e-10), (wyk_tr / math.max(ta.sma(wyk_tr, 20), 1e-10) - net_deriv_volume / math.max(ta.sma(net_deriv_volume, 20), 1e-10)) * (c > o ? 1.0 : -1.0))
score15  = f_matrix_core(150, 42, 3, ta.mfi(c, 42), ta.sma(clv_factor * net_deriv_volume, 60) / math.max(ta.sma(net_deriv_volume, 60), 1e-10), (wyk_tr / math.max(ta.sma(wyk_tr, 60), 1e-10) - net_deriv_volume / math.max(ta.sma(net_deriv_volume, 60), 1e-10)) * (c > o ? 1.0 : -1.0))
score60  = f_matrix_core(600, 168, 12, ta.mfi(c, 168), ta.sma(clv_factor * net_deriv_volume, 240) / math.max(ta.sma(net_deriv_volume, 240), 1e-10), (wyk_tr / math.max(ta.sma(wyk_tr, 240), 1e-10) - net_deriv_volume / math.max(ta.sma(net_deriv_volume, 240), 1e-10)) * (c > o ? 1.0 : -1.0))
score120 = f_matrix_core(1200, 336, 24, ta.mfi(c, 336), ta.sma(clv_factor * net_deriv_volume, 480) / math.max(ta.sma(net_deriv_volume, 480), 1e-10), (wyk_tr / math.max(ta.sma(wyk_tr, 480), 1e-10) - net_deriv_volume / math.max(ta.sma(net_deriv_volume, 480), 1e-10)) * (c > o ? 1.0 : -1.0))
score240 = f_matrix_core(2400, 672, 48, ta.mfi(c, 672), ta.sma(clv_factor * net_deriv_volume, 960) / math.max(ta.sma(net_deriv_volume, 960), 1e-10), (wyk_tr / math.max(ta.sma(wyk_tr, 960), 1e-10) - net_deriv_volume / math.max(ta.sma(net_deriv_volume, 960), 1e-10)) * (c > o ? 1.0 : -1.0))

// ── Section 6: Composite Fusion Layer ──
float volume_composite = (score5 + score15 + score60 + score120 + score240) / 5
float grand_composite  = (volume_composite * 0.90) + (fut_oi_sent * 0.10)

float wma11 = ta.wma(grand_composite, 11)
float rsi30 = ta.rsi(wma11, 30) 
float final = ta.wma(rsi30, 21) 

// ── Section 7: Dashboard ──
var table dash = table.new(position.top_right, 2, 7, bgcolor=color.new(#1e222d, 85))
if barstate.islast
    table.cell(dash, 0, 0, "Grand OTM Matrix", text_color=color.white, bgcolor=#363a45)
    table.cell(dash, 1, 0, "Index Value (0-100)", text_color=color.white, bgcolor=#363a45)
    table.cell(dash, 0, 1, "5M Native Score", text_color=color.orange), table.cell(dash, 1, 1, str.tostring(score5, "#.##"))
    table.cell(dash, 0, 2, "15M Equivalent", text_color=color.yellow), table.cell(dash, 1, 2, str.tostring(score15, "#.##"))
    table.cell(dash, 0, 3, "60M Equivalent", text_color=color.aqua), table.cell(dash, 1, 3, str.tostring(score60, "#.##"))
    table.cell(dash, 0, 4, "120M Equivalent", text_color=color.teal), table.cell(dash, 1, 4, str.tostring(score120, "#.##"))
    table.cell(dash, 0, 5, "240M Equivalent", text_color=color.lime), table.cell(dash, 1, 5, str.tostring(score240, "#.##"))
    table.cell(dash, 0, 6, "Unified Grand Signal", text_color=color.blue, text_size=size.large)
    table.cell(dash, 1, 6, str.tostring(final, "#.##"), text_color=color.white, bgcolor=color.blue, text_size=size.large)

// ── Section 8: Visual Plots ──
plot(rsi30, "Raw OTM Composite Matrix (Yellow)", color=color.yellow, linewidth=2)
plot(final, "Grand OTM Composite Signal (Blue)", color=color.blue, linewidth=2)

hline(70, "Institutional Breakout", color=color.new(color.green, 60))
hline(50, "Market Equilibrium Line", color=color.gray, linestyle=hline.style_dashed)
hline(30, "Institutional Absorption", color=color.new(color.red, 60))
